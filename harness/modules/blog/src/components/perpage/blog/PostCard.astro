---
import { Image } from "astro:assets";
import { LOCALE } from "@/config/companyInfo";
import type { BlogPost } from "@/utils/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, image, publishDate } = post.data;

// Frontmatter dates are parsed as UTC midnight: format them in UTC, or a site in a
// negative offset (es-CO is UTC-5) shows the previous day.
const formattedDate = new Intl.DateTimeFormat(LOCALE, {
  dateStyle: "long",
  timeZone: "UTC",
}).format(publishDate);
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-soft-bg ring-1 ring-blue-mist focus-within:ring-2 focus-within:ring-purple-accent hover:ring-purple-accent">
  <Image
    src={image}
    alt={title}
    widths={[400, 800]}
    sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
    class="aspect-video w-full object-cover"
  />

  <div class="flex flex-1 flex-col p-6 md:p-7">
    <time
      datetime={publishDate.toISOString()}
      class="flex items-center gap-3 text-sm font-semibold tracking-wide text-purple-accent uppercase"
    >
      <span
        aria-hidden="true"
        class="block h-0.5 w-6 rounded-full bg-olive"
      ></span>
      {formattedDate}
    </time>

    <h2 class="mt-4 text-xl leading-snug font-bold text-balance text-purple-dark md:text-2xl">
      <a
        href={`/blog/${post.id}/`}
        class="after:absolute after:inset-0 focus-visible:outline-none"
      >
        {title}
      </a>
    </h2>

    <p class="mt-3 text-pretty text-purple-accent">{description}</p>

    <span
      aria-hidden="true"
      class="mt-auto pt-6 text-sm font-semibold text-purple-dark underline-offset-4 group-hover:underline"
    >
      Leer artículo →
    </span>
  </div>
</article>
