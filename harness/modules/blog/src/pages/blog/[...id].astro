---
import { Image } from "astro:assets";
import { render } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { LOCALE } from "@/config/companyInfo";
import { generatePageSEO, generateBreadcrumbSchema } from "@/config/seo";
import { generateBlogPostingSchema } from "@/config/blogSeo";
import { getAllPosts, type BlogPost } from "@/utils/posts";

// The route param is post.id — the frontmatter `slug` — never the filename.
export const getStaticPaths = async () => {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, image, publishDate } = post.data;
const { Content } = await render(post);

// Frontmatter dates are parsed as UTC midnight: format them in UTC, or a site in a
// negative offset (es-CO is UTC-5) shows the previous day.
const formattedDate = new Intl.DateTimeFormat(LOCALE, {
  dateStyle: "long",
  timeZone: "UTC",
}).format(publishDate);

const seoProps = generatePageSEO({ title, description, image: image.src });

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: title, path: `/blog/${post.id}/` },
]);
---

<MainLayout seoProps={seoProps} schemas={[breadcrumbSchema]}>
  <article>
    <header class="bg-soft-beige px-4 pt-10 pb-16 md:pt-14 md:pb-24">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Ruta de navegación">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-purple-accent">
            <li>
              <a
                href="/"
                class="underline-offset-4 hover:text-purple-dark hover:underline"
              >
                Inicio
              </a>
            </li>
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              <a
                href="/blog/"
                class="underline-offset-4 hover:text-purple-dark hover:underline"
              >
                Blog
              </a>
            </li>
            <li class="flex max-w-full min-w-0 items-center gap-2">
              <span aria-hidden="true">/</span>
              <span
                aria-current="page"
                class="min-w-0 truncate text-purple-dark"
              >
                {title}
              </span>
            </li>
          </ol>
        </nav>

        <time
          datetime={publishDate.toISOString()}
          class="mt-12 flex items-center gap-3 text-sm font-semibold tracking-wide text-purple-accent uppercase md:mt-16"
        >
          <span
            aria-hidden="true"
            class="block h-0.5 w-6 rounded-full bg-olive"
          ></span>
          {formattedDate}
        </time>

        <h1 class="mt-5 text-4xl font-bold tracking-tight text-balance text-purple-dark md:text-5xl">
          {title}
        </h1>

        <p class="mt-6 text-lg text-pretty text-purple-accent md:text-xl">
          {description}
        </p>
      </div>
    </header>

    <div class="bg-linear-to-b from-soft-beige from-50% to-soft-bg to-50% px-4">
      <Image
        src={image}
        alt={title}
        widths={[640, 960, 1280, 1792]}
        sizes="(min-width: 960px) 896px, 100vw"
        priority
        class="mx-auto aspect-video w-full max-w-4xl rounded-2xl object-cover"
      />
    </div>

    {/* Markdown body: <Content /> emits bare tags, so its h2/h3, lists and links
        are styled from this wrapper with descendant variants. */}
    <div class="mx-auto max-w-3xl space-y-6 px-4 py-14 text-lg leading-relaxed text-pretty text-purple-dark md:py-20 [&>:first-child]:mt-0 [&_a]:font-semibold [&_a]:text-purple-accent [&_a]:underline [&_a]:decoration-olive [&_a]:decoration-2 [&_a]:underline-offset-4 [&_a]:hover:text-purple-dark [&_a]:hover:decoration-purple-dark [&_h2]:mt-14 [&_h2]:text-2xl [&_h2]:leading-tight [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-balance [&_h2]:before:mb-4 [&_h2]:before:block [&_h2]:before:h-0.5 [&_h2]:before:w-6 [&_h2]:before:rounded-full [&_h2]:before:bg-olive md:[&_h2]:text-3xl [&_h3]:mt-10 [&_h3]:text-xl [&_h3]:leading-snug [&_h3]:font-semibold [&_h3]:text-balance md:[&_h3]:text-2xl [&_li]:mt-2 [&_li]:pl-1 [&_li]:marker:text-purple-accent [&_ol]:list-decimal [&_ol]:pl-6 [&_ul]:list-disc [&_ul]:pl-6">
      <Content />
    </div>

    <JsonLd schema={generateBlogPostingSchema(post)} />
  </article>
</MainLayout>
